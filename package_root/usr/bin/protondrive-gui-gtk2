#!/usr/bin/env python2
# -*- coding: utf-8 -*-
import pygtk
pygtk.require('2.0')
import gtk

def on_delete(widget, event, data=None):
    gtk.main_quit()
    return False

def on_button_clicked(widget):
    dialog = gtk.MessageDialog(None, gtk.DIALOG_MODAL, gtk.MESSAGE_INFO, gtk.BUTTONS_OK, "ProtonDrive prototype")
    dialog.format_secondary_text("Bouton cliqué !")
    dialog.run()
    dialog.destroy()

def main():
    window = gtk.Window(gtk.WINDOW_TOPLEVEL)
    window.set_title("ProtonDrive")
    window.set_default_size(400, 200)
    window.connect("delete-event", on_delete)

    vbox = gtk.VBox(False, 10)
    vbox.set_border_width(10)
    button = gtk.Button("Cliquez-moi")
    button.connect("clicked", on_button_clicked)
    vbox.pack_start(button, False, False, 0)

    window.add(vbox)
    window.show_all()
    gtk.main()

if __name__ == "__main__":
    main()
